# Local Development Environment Configuration

# 🚨 REQUIRED: Add your OpenAI API key here
# Get it from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key_here_replace_this

# Application Settings
APP_NAME=AskDocs
APP_ENV=development
DEBUG=true
API_VERSION=v1
HOST=0.0.0.0
PORT=8000

# Database (matches docker-compose.yml)
POSTGRES_PASSWORD=askdocs123
DATABASE_URL=postgresql://askdocs_user:askdocs123@localhost:5432/askdocs_dev

# Redis (matches docker-compose.yml)
REDIS_PASSWORD=redis123
REDIS_URL=redis://localhost:6379/0

# JWT Authentication (change this for production)
JWT_SECRET=your_super_secure_jwt_secret_key_for_development_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenAI Models
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-ada-002

# Stripe Billing (optional for local testing - use test keys)
STRIPE_SECRET_KEY=sk_test_your_stripe_test_secret_key_optional
STRIPE_WEBHOOK_SECRET=whsec_test_your_stripe_webhook_secret_optional
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_test_publishable_key_optional

# URLs (Local development)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# CORS Settings
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100

# Logging & Monitoring
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Background Jobs
WORKER_CONCURRENCY=2
WORKER_MAX_TASKS_PER_CHILD=100
ARQ_REDIS_URL=redis://localhost:6379/1

# Vector Database (Local)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Search Configuration
MAX_SEARCH_RESULTS=20
SEARCH_TIMEOUT_SECONDS=30

# Document Processing
MAX_FILE_SIZE_MB=10
SUPPORTED_FILE_TYPES=pdf,docx,txt,md
MAX_CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Feature Flags (disable billing for local testing)
ENABLE_REGISTRATION=true
ENABLE_BILLING=false
ENABLE_ANALYTICS=true
ENABLE_MONITORING=true

# Frontend Environment Variables (automatically used by Next.js)
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_NAME=AskDocs
NEXT_PUBLIC_APP_DESCRIPTION=AI-powered document Q&A platform