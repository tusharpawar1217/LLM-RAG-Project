# Production Environment Configuration
# Copy this file to .env.prod and fill in your values

# Domain and URLs
DOMAIN=yourdomain.com
FRONTEND_URL=https://yourdomain.com
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com

# Database
POSTGRES_PASSWORD=your_secure_postgres_password_here
DATABASE_URL=postgresql://askdocs_user:your_secure_postgres_password_here@postgres:5432/askdocs_prod

# Redis
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_URL=redis://redis:6379/0

# JWT Authentication
JWT_SECRET=your_very_secure_jwt_secret_here_at_least_32_characters

# OpenAI API
OPENAI_API_KEY=sk-your_openai_api_key_here

# Stripe Billing
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key_here

# SSL/TLS
ACME_EMAIL=your_email@yourdomain.com

# Monitoring
GRAFANA_USER=admin
GRAFANA_PASSWORD=your_secure_grafana_password_here

# Email (Optional - for notifications)
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=your_smtp_password_here
FROM_EMAIL=AskDocs <noreply@yourdomain.com>

# File Storage (Optional - for S3/MinIO)
S3_BUCKET=askdocs-storage
S3_REGION=us-east-1
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com

# Rate Limiting
RATE_LIMIT_REDIS_URL=redis://redis:6379/1
RATE_LIMIT_PER_MINUTE=60

# Sentry (Optional - for error tracking)
SENTRY_DSN=https://your_sentry_dsn_here
SENTRY_ENVIRONMENT=production

# Google Analytics (Optional)
NEXT_PUBLIC_GA_TRACKING_ID=UA-your_tracking_id_here

# Feature Flags
ENABLE_REGISTRATION=true
ENABLE_BILLING=true
ENABLE_ANALYTICS=true
ENABLE_MONITORING=true

# Worker Configuration
WORKER_CONCURRENCY=4
WORKER_MAX_TASKS_PER_CHILD=1000

# Vector Database
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=your_qdrant_api_key_if_needed

# Search Configuration
MAX_SEARCH_RESULTS=20
SEARCH_TIMEOUT_SECONDS=30

# Document Processing
MAX_FILE_SIZE_MB=50
SUPPORTED_FILE_TYPES=pdf,docx,txt,md
MAX_CHUNK_SIZE=1000
CHUNK_OVERLAP=200