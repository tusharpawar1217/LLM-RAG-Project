# Application
APP_NAME=AskDocs
APP_ENV=development
DEBUG=true
API_VERSION=v1
SECRET_KEY=your-secret-key-min-32-chars-change-in-production

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=true

# Database
DATABASE_URL=postgresql+asyncpg://askdocs:askdocs_password@postgres:5432/askdocs
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=askdocs_tenant_

# OpenAI
OPENAI_API_KEY=sk-your-openai-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_EMBEDDING_BATCH_SIZE=100

# LLM Configuration
PRIMARY_LLM_PROVIDER=openai
PRIMARY_LLM_MODEL=gpt-4o-mini
FALLBACK_LLM_PROVIDER=openai
FALLBACK_LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=60

# Anthropic (optional)
ANTHROPIC_API_KEY=

# Retrieval
CHUNK_SIZE=800
CHUNK_OVERLAP=200
CHUNKING_STRATEGY=recursive  # recursive, markdown
TOP_K_DENSE=10
TOP_K_SPARSE=10
TOP_K_FINAL=5
RRF_K=60
ENABLE_RERANKER=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-12-v2

# Citation Verification
CITATION_CONFIDENCE_THRESHOLD=0.7
VERIFICATION_USE_LLM_JUDGE=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOW_CREDENTIALS=true

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# API Keys
API_KEY_PREFIX=ask_
API_KEY_LENGTH=32

# Billing
STRIPE_API_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_ID_STARTER=price_starter_monthly
STRIPE_PRICE_ID_PRO=price_pro_monthly
STRIPE_PRICE_ID_ENTERPRISE=price_enterprise_monthly

# Razorpay (alternative)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Plans & Limits
TRIAL_DURATION_DAYS=14
STARTER_MAX_DOCUMENTS=50
STARTER_MAX_MESSAGES=1000
PRO_MAX_DOCUMENTS=500
PRO_MAX_MESSAGES=10000
ENTERPRISE_MAX_DOCUMENTS=10000
ENTERPRISE_MAX_MESSAGES=100000

# Worker
ARQ_WORKER_CONCURRENCY=10
ARQ_MAX_JOBS=100
UPLOAD_DIR=/tmp/askdocs/uploads

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=INFO
LOG_FORMAT=json  # json or console

# Email (for handoff notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@askdocs.ai

# Widget
WIDGET_CDN_URL=http://localhost:8000/static/widget
WIDGET_DEFAULT_PRIMARY_COLOR=#3b82f6
WIDGET_DEFAULT_BOT_NAME=Support Bot

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
